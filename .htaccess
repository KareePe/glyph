# =========================================================
# Clean URLs — serve pages without the .html extension
#   /glyph/about        -> about.html
#   /glyph/about.html   -> 301 redirect to /glyph/about
#   /glyph/index.html   -> 301 redirect to /glyph/
# No RewriteBase is hard-coded, so this works in a sub-folder
# (localhost/glyph/) and at a domain root alike.
# =========================================================

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Redirect direct .html requests to the clean URL (only for real browser requests,
  #    not internal rewrites, to avoid loops). Keeps the query string.
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?(?:index)?([^/\s?]*?)\.html[\s?] [NC]
  RewriteRule ^ /%1%2 [R=301,L,NE]

  # 2) Remove a trailing slash from page URLs (/about/ -> /about) so relative
  #    asset paths (./assets/...) keep resolving correctly. Real folders are untouched.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L,NE]

  # 3) Map a clean URL to its .html file when that file exists.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
